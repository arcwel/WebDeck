import("//mojo/public/tools/bindings/mojom.gni")

assert(is_win || is_mac || is_linux)

# The agent's tab-control interface, exposed to chrome://webdeck only.
# webui_module_path makes the generated JS importable from the page.
mojom("mojo_bindings") {
  sources = [ "webdeck.mojom" ]
  webui_module_path = "/"

  # Shell.SetStageBounds takes a gfx.mojom.Rect.
  public_deps = [ "//ui/gfx/geometry/mojom" ]
}

source_set("webdeck") {
  sources = [
    "webdeck_adblock.h",
    "webdeck_agent_tabs.h",
    "webdeck_shell.h",
    "webdeck_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common:headers",
  ]
}

source_set("impl") {
  sources = [
    "webdeck_adblock.cc",
    "webdeck_agent_tabs.cc",
    "webdeck_shell.cc",
    "webdeck_ui.cc",
  ]

  public_deps = [ "//chrome/browser:browser_public_dependencies" ]

  deps = [
    ":webdeck",
    "//chrome/browser/browsing_data:constants",
    "//net",
    "//services/network/public/cpp",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/webdeck:resources",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    # Pinned extension actions (the toolbar the shell draws) and the signed-in
    # account behind the profile button.
    "//chrome/browser/extensions",
    "//chrome/browser/ui/toolbar",
    # Start-page site icons (chrome://favicon2).
    "//chrome/browser/ui/webui:favicon_source",
    "//components/favicon_base",
    "//components/sessions:session_id",
    "//components/signin/public/identity_manager",
    "//extensions/browser",
    "//extensions/common",
    "//google_apis",
    "//chrome/browser/webdeck:core_service",
    "//chrome/browser/webdeck:shell_host",
    "//chrome/common",
    "//chrome/common:constants",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/find_in_page",
    "//components/prefs",
    "//components/tabs:public",
    "//components/zoom",
    "//services/media_session/public/mojom",
    "//services/network/public/mojom",
    "//ui/base",
    # CaptureStage: the stage still, JPEG-encoded off the UI thread.
    "//ui/gfx/codec",
    "//components/viz/common",
    "//ui/shell_dialogs",
    "//ui/webui",
    "//url",
  ]
}
