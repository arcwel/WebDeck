+// WebDeck: the window a dropped-on WebContents belongs to, and whether that
+// WebContents is the window's own shell page rather than a tab.
+//
+// The shell page is not a tab — it is the window's own contents — so the tab
+// lookup cannot see it, and the shell records its window itself.
+static BrowserWindowInterface* WebDeckWindowForDrop(
+    content::WebContents* web_contents,
+    bool* is_shell) {
+  if (auto* host = webdeck::WebDeckShellHost::FromWebContents(web_contents)) {
+    *is_shell = true;
+    return host->window();
+  }
+  *is_shell = false;
+  return GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+      web_contents);
+}
+
 void ChromeWebContentsViewDelegateViewsMac::OnPerformingDrop(
     const content::DropData& drop_data,
     DropCompletionCallback callback) {
+  // WebDeck: a file dropped on a page is offered to the window's shell before
+  // the page ever sees it. This is the only place the drop can be caught: a
+  // file dropped on the page never reaches the window's own drop handler
+  // (that one covers the tab strip and toolbar), and a File handed to
+  // JavaScript carries bytes and a name but never a location, so the page
+  // could not open it from disk even if it did receive it.
+  //
+  // What the shell takes opens in its reader. What it does not take depends
+  // on where the drop landed:
+  //
+  // - On the SHELL page, Chromium's default would be to navigate the shell
+  //   itself to the file, which a chrome:// page refuses — the drop would do
+  //   nothing. So every file the shell hands back is opened as a new tab,
+  //   exactly as a drop on the tab strip is, and the drop is then completed
+  //   with nothing so the shell page stays put.
+  // - On an ordinary TAB, the file passes through untouched and Chromium does
+  //   what it always does with a file dropped on a page.
+  if (!drop_data.filenames.empty()) {
+    bool is_shell = false;
+    BrowserWindowInterface* window =
+        WebDeckWindowForDrop(web_contents_, &is_shell);
+    if (window) {
+      std::vector<base::FilePath> paths;
+      paths.reserve(drop_data.filenames.size());
+      for (const ui::FileInfo& file : drop_data.filenames) {
+        paths.push_back(file.path);
+      }
+      const std::vector<base::FilePath> unclaimed =
+          webdeck::ForwardDroppedFiles(window, paths);
+      if (is_shell) {
+        // Reverse order, so a multi-file drop ends up in dropped order and
+        // the first file is the one in front.
+        for (auto it = unclaimed.rbegin(); it != unclaimed.rend(); ++it) {
+          NavigateParams params(window, net::FilePathToFileURL(*it),
+                                ui::PAGE_TRANSITION_LINK);
+          params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+          params.window_action = NavigateParams::WindowAction::kShowWindow;
+          Navigate(&params);
+        }
+        webdeck::RecordDropNote(
+            "opened " + base::NumberToString(unclaimed.size()) +
+            " unclaimed file(s) as tabs; drop cancelled on the shell page");
+        std::move(callback).Run(std::nullopt);
+        return;
+      }
+      if (unclaimed.empty()) {
+        std::move(callback).Run(std::nullopt);
+        return;
+      }
+      if (unclaimed.size() != paths.size()) {
+        content::DropData remaining = drop_data;
+        remaining.filenames.clear();
+        for (const base::FilePath& path : unclaimed) {
+          remaining.filenames.emplace_back(path, base::FilePath());
+        }
+        HandleOnPerformingDrop(web_contents_, remaining, std::move(callback));
+        return;
+      }
+    } else {
+      webdeck::RecordDropNote("dropped on a page with no window");
+    }
+  }
   HandleOnPerformingDrop(web_contents_, drop_data, std::move(callback));
 }
 
