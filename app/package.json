{
  "name": "webdeck",
  "version": "0.1.5",
  "description": "Arcwel WebDeck \u2014 an agent-first browser with a summonable IDE",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:webui",
    "build:webui": "node scripts/gen-licenses.mjs && vite build --config vite.webui.config.ts",
    "pack:webui": "node scripts/gen-mojo-bindings.mjs && npm run build:webui && node scripts/pack-webui.mjs",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "node scripts/build-core.mjs",
    "verify:core": "node scripts/verify-core-binary.mjs",
    "verify:fork": "node scripts/verify-fork.mjs",
    "verify:session": "node scripts/verify-session-mode.mjs",
    "verify:hardening": "node scripts/verify-hardening.mjs",
    "upstream:check": "node scripts/upstream-check.mjs",
    "update:check": "node scripts/update-check.mjs",
    "perf": "node scripts/perf.mjs",
    "verify:patches": "node scripts/verify-patches.mjs",
    "verify:fork:all": "npm run verify:patches && npm run verify:fork && npm run verify:hardening",
    "package:dmg": "node scripts/package-fork.mjs",
    "release:dmg": "node scripts/package-fork.mjs --identity auto --notary-profile webdeck-notary",
    "release:preflight": "node scripts/release-preflight.mjs",
    "dev:signing-identity": "node scripts/dev-signing-identity.mjs",
    "gen:mojo": "node scripts/gen-mojo-bindings.mjs",
    "pack:webui:release": "node scripts/gen-mojo-bindings.mjs --build-dir out/webdeck-release && npm run build:webui && node scripts/pack-webui.mjs --build-dir out/webdeck-release",
    "rebase:fork": "node scripts/rebase-fork.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@codingame/monaco-vscode-api": "~25.1.2",
    "@codingame/monaco-vscode-configuration-service-override": "~25.1.2",
    "@codingame/monaco-vscode-css-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-extensions-service-override": "~25.1.2",
    "@codingame/monaco-vscode-files-service-override": "~25.1.2",
    "@codingame/monaco-vscode-html-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-ini-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-javascript-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-json-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-keybindings-service-override": "~25.1.2",
    "@codingame/monaco-vscode-languages-service-override": "~25.1.2",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-python-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-quickaccess-service-override": "~25.1.2",
    "@codingame/monaco-vscode-shellscript-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-textmate-service-override": "~25.1.2",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-theme-service-override": "~25.1.2",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-xml-default-extension": "~25.1.2",
    "@codingame/monaco-vscode-yaml-default-extension": "~25.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.11.1",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.4",
    "mermaid": "^11.17.2",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~25.1.2",
    "monaco-languageclient": "^10.7.0",
    "node-pty": "^1.1.0",
    "papaparse": "^5.7.0",
    "pyright": "^1.1.413",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "reveal.js": "^6.0.1",
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^4.4.1",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@~25.1.2",
    "vscode-jsonrpc": "~8.2.0",
    "vscode-languageclient": "~9.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.62.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.10",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.9",
    "ws": "^8.21.3"
  },
  "productName": "Arcwel WebDeck",
  "author": "Arcwel"
}
